---
import { Image } from "astro:assets";
import home from '../images/homepage.jpg';
import Nav from "../components/Navbar.astro"
import Footer from "../components/Footer.astro"
---
<Nav />
<nav class="homepage">
  <div class="title">
    <Image 
    src = {home} 
    alt="home"
    class="full-screen-img">
  </div>
</nav>
<Footer />

<style>
* {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }
  .title img{
    display: flex;
    width: 100%;
    height: auto;
    justify-content: center;
    align-items: center;
  }
    
</style>


