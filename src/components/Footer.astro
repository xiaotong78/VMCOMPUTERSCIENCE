---
/* Footer.astro */
---

<footer class="footer">
  <svg class="footer-bg" viewBox="0 0 1400 300" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
    <polygon points="0,300 400,300 200,100 0,200" fill="#1a0b2e" opacity="0.8" />
    <polygon points="1000,300 1400,300 1400,100 1100,200" fill="#4c1d95" opacity="0.6" />
    <polygon points="1150,300 1400,300 1400,0 1250,150" fill="#7c3aed" opacity="0.4" />
    <polygon points="0,300 150,300 0,150" fill="#5b21b6" opacity="0.5" />
  </svg>

  <div class="footer-container">
    <div class="contact-info">
      <h3>Vincent Massey High School</h3>
      <p>715 McDiarmid Drive</p>
      <p>R7B 2H7</p>
      <div class="footer-links">
        <a href="mailto:contact@vmhs.ca" class="glitch-link" data-text="Email Us">Email Us</a>
        <span class="separator">|</span>
        <a href="tel:2047293100" class="glitch-link" data-text="204-729-3100">204-729-3100</a>
      </div>
    </div>
    
    <div class="footer-tag">
      <p>// TERMINAL_CONTACT_v1.0</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: absolute;
    width: 100%;
    min-height: 250px;
    background: #0f051a; /* Matching your dark theme */
    margin-top: 100px;
    overflow: hidden;
    /* Angled top edge to match the cool vibe */
    clip-path: polygon(0 20%, 15% 0, 85% 0, 100% 20%, 100% 100%, 0 100%);
    border-top: 2px solid #7c3aed;
  }

  .footer-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    pointer-events: none;
  }

  .footer-container {
    position: relative;
    z-index: 2;
    max-width: 1200px;
    margin: 0 auto;
    padding: 60px 2rem 40px;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
  }

  .contact-info {
    font-family: 'Pixelify Sans', sans-serif;
    color: #d8b4fe;
  }

  .contact-info h3 {
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
    color: #fff;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .contact-info p {
    font-size: 1.1rem;
    line-height: 1.4;
    opacity: 0.9;
  }

  .footer-links {
    margin-top: 1.5rem;
    display: flex;
    gap: 15px;
    align-items: center;
  }

  .glitch-link {
    color: #e879f9;
    text-decoration: none;
    position: relative;
    transition: 0.2s;
  }

  .separator {
    color: #4c1d95;
  }

  /* Re-using your glitch effect for consistency */
  .glitch-link:hover {
    color: #fff;
    text-shadow: 2px 0 #ff00c1, -2px 0 #00fff9;
    animation: shiver 0.2s infinite;
  }

  @keyframes shiver {
    0% { transform: translate(1px, 1px); }
    50% { transform: translate(-1px, -1px); }
    100% { transform: translate(0); }
  }

  .footer-tag {
    font-family: monospace;
    color: #4c1d95;
    font-size: 0.8rem;
    letter-spacing: 2px;
  }

  @media (max-width: 768px) {
    .footer-container {
      flex-direction: column;
      align-items: flex-start;
      gap: 30px;
    }
  }
</style>