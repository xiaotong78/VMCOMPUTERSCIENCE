---
import { Image } from "astro:assets";
import vmhslogo from '../images/cslogo.png';
---
<nav id="navbar" class="nav">
    <svg class="nav-triangles" viewBox="0 0 1200 200" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
        <polygon class="tri t1" points="0,0 300,0 0,180"/>
        <polygon class="tri t2" points="200,0 600,0 400,200"/>
        <polygon class="tri t3" points="500,0 900,0 750,180"/>
        <polygon class="tri t4" points="800,0 1200,0 1200,160"/>
        <polygon class="tri-dark td1" points="0,0 150,0 0,100"/>
        <polygon class="tri-dark td2" points="1000,0 1200,0 1200,120"/>
        <polygon class="tri-dark td3" points="400,0 800,0 600,150"/>
    </svg>
    
    <div class="nav-container">
        <ul class="nav-links left">
            <li><a href="https://vmcomputerscience.netlify.app/edweek" data-text="edweek">edweek</a></li>
            <li><a href="https://vmcomputerscience.netlify.app/gallery" data-text="gallery">gallery</a></li>
        </ul>

        <div class="logo">
            <a href="https://vmcomputerscience.netlify.app/">
                <Image src={vmhslogo} alt="logo" />
            </a>
        </div>

        <ul class="nav-links right">
            <li><a href="https://vmcomputerscience.netlify.app/members" data-text="members">members</a></li>
            <li><a href="https://vmcomputerscience.netlify.app/about" data-text="about">about</a></li>
        </ul>
    </div>
</nav>

<style is:global>
    @import url('https://fonts.googleapis.com/css2?family=Pixelify+Sans:wght@400..700&display=swap');

    * { margin: 0; padding: 0; box-sizing: border-box; }

    .nav {
        position: fixed;
        width: 100%;
        z-index: 100;
        top: 0;
        height: 140px; 
        background: #1a0b2e;
        clip-path: polygon(0 0, 100% 0, 100% 70%, 90% 100%, 75% 75%, 50% 90%, 25% 75%, 10% 100%, 0 70%);
        border-bottom: 3px solid #d8b4fe;
        overflow: hidden;
        transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .nav-container {
        position: relative;
        z-index: 2;
        display: flex;
        justify-content: center;
        align-items: center;
        width: 100%;
        max-width: 1400px;
        margin: 0 auto;
        padding: 0 2rem;
        height: 100px; 
    }

    .nav-triangles {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
        z-index: 1;
    }

    .tri { fill: #683aa8; opacity: 0.6; }
    .tri.t1 { fill: #4c1d95; }
    .tri.t2 { fill: #7c3aed; }
    .tri.t3 { fill: #5b21b6; }
    .tri-dark { fill: #0f051a; opacity: 0.8; }

    .nav-links {
        display: flex;
        list-style: none;
        gap: 40px;
        flex: 1;
    }

    .nav-links.left { justify-content: flex-end; padding-right: 20px; }
    .nav-links.right { justify-content: flex-start; padding-left: 20px; }

    .nav-links a {
        font-family: 'Pixelify Sans', sans-serif;
        color: #d8b4fe;
        text-decoration: none;
        font-size: 2rem;
        text-transform: uppercase;
        padding: 8px 16px;
        background: #5b21b6;
        border-radius: 2px;
        /* 2. REMOVED transition: all 0.1s - It fights the animation jitter */
        transition: background-color 0.2s, color 0.2s, box-shadow 0.2s;
        white-space: nowrap;
        position: relative;
        display: inline-block;
    }

    .nav-links a:hover {
        background-color: #d8b4fe;
        color: #1a0b2e;
        box-shadow: 0 0 20px rgba(216, 180, 254, 0.6);
        text-shadow: 2px 0 #ff00c1, -2px 0 #00fff9;
        /* 3. INCREASED animation speed to 0.08s for high-frequency shivering */
        animation: shiver 0.15s infinite linear;
    }

    @keyframes shiver {
        0% { transform: translate(1px, -1px); }
        25% { transform: translate(-3px, -4px); }
        50% { transform: translate(3px, -3px); }
        75% { transform: translate(-2px, -3px); }
        100% { transform: translate(0, -2px); }
    }

    .logo img {
        height: 150px;
        width: auto;
        filter: drop-shadow(0 0 100px #d8b4fe);
        transition: transform 0.3s;
    }

    .logo:hover img { transform: scale(1.1); }
</style>

<script>
    let lastScrollY = window.scrollY;
    const navbar = document.getElementById('navbar');
    window.addEventListener('scroll', () => {
        if (navbar) {
            navbar.style.transform = window.scrollY > lastScrollY
                ? 'translateY(-100%)'
                : 'translateY(0)';
            lastScrollY = window.scrollY;
        }
    });
</script>