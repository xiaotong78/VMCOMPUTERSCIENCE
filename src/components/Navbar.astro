---
import { Image } from "astro:assets";
import vmhslogo from '../images/vmhslogo.webp';
---
<nav id="navbar" class="nav">
    <!-- Glitchy triangle background SVG -->
    <svg class="nav-triangles" viewBox="0 0 1200 120" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
        <!-- Static base triangles -->
        <polygon class="tri t1" points="0,0 180,0 80,120"/>
        <polygon class="tri t2" points="120,0 320,0 200,120"/>
        <polygon class="tri t3" points="280,0 420,0 360,120"/>
        <polygon class="tri t4" points="380,0 520,0 480,120"/>
        <polygon class="tri t5" points="500,0 600,0 560,120"/>
        <polygon class="tri t6" points="600,0 700,0 640,120"/>
        <polygon class="tri t7" points="660,0 820,0 720,120"/>
        <polygon class="tri t8" points="780,0 940,0 880,120"/>
        <polygon class="tri t9" points="900,0 1050,0 980,120"/>
        <polygon class="tri t10" points="1000,0 1200,0 1100,120"/>
        <polygon class="tri t11" points="1080,0 1200,0 1200,80"/>
        <polygon class="tri t12" points="0,0 0,80 100,0"/>
        <!-- Dark accent triangles -->
        <polygon class="tri-dark td1" points="160,0 260,0 200,120"/>
        <polygon class="tri-dark td2" points="440,0 560,0 500,120"/>
        <polygon class="tri-dark td3" points="740,0 860,0 800,120"/>
        <polygon class="tri-dark td4" points="980,0 1100,0 1040,120"/>
        <!-- Glitch triangles (animated) -->
        <polygon class="tri-glitch tg1" points="50,0 200,0 130,120"/>
        <polygon class="tri-glitch tg2" points="550,0 680,0 620,120"/>
        <polygon class="tri-glitch tg3" points="870,0 1020,0 950,120"/>
        <!-- Bright accent flicker triangles -->
        <polygon class="tri-bright tb1" points="300,0 380,0 340,60"/>
        <polygon class="tri-bright tb2" points="700,0 780,0 740,60"/>
        <polygon class="tri-bright tb3" points="1100,0 1180,0 1140,60"/>
    </svg>

    <ul class="nav-links">
        <li><a href="https://vmcomputerscience.netlify.app/edweek">edweek</a></li>
        <li><a href="https://vmcomputerscience.netlify.app/gallery">gallery</a></li>
    </ul>
    <div class="logo">
        <a href="https://vmcomputerscience.netlify.app/">
            <Image src={vmhslogo} alt="logo" />
        </a>
    </div>
    <ul class="nav-links">
        <li><a href="https://vmcomputerscience.netlify.app/members">members</a></li>
        <li><a href="https://vmcomputerscience.netlify.app/about">about</a></li>
    </ul>
</nav>

<style>
    @import url('https://fonts.googleapis.com/css2?family=Pixelify+Sans:wght@400..700&display=swap');

    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        margin: 0;
        padding: 0;
    }

    /* ── Navbar shell ── */
    .nav {
        position: fixed;
        width: 100%;
        z-index: 100;
        top: 0;
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0 2rem;
        height: 120px;

        background: linear-gradient(135deg, #1a0b2e 0%, #683aa8 45%, #4c1d95 55%, #1a0b2e 100%);
        clip-path: polygon(0 0, 100% 0, 100% 70%, 85% 90%, 50% 100%, 15% 90%, 0 70%);
        transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        border-bottom: 2px solid #d8b4fe;
        overflow: hidden; /* keep triangles clipped inside nav */
    }

    /* ── Triangle SVG layer ── */
    .nav-triangles {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
        z-index: 0;
    }

    /* Base purple triangles */
    .tri {
        fill: #7c3aed;
        opacity: 0.25;
    }
    .tri.t1  { fill: #9d4edd; }
    .tri.t2  { fill: #5b21b6; }
    .tri.t3  { fill: #7c3aed; }
    .tri.t4  { fill: #9d4edd; opacity: 0.3; }
    .tri.t5  { fill: #4c1d95; }
    .tri.t6  { fill: #7c3aed; opacity: 0.2; }
    .tri.t7  { fill: #9d4edd; opacity: 0.25; }
    .tri.t8  { fill: #5b21b6; opacity: 0.3; }
    .tri.t9  { fill: #7c3aed; }
    .tri.t10 { fill: #9d4edd; opacity: 0.2; }
    .tri.t11 { fill: #4c1d95; opacity: 0.35; }
    .tri.t12 { fill: #5b21b6; opacity: 0.35; }

    /* Dark navy triangles */
    .tri-dark {
        fill: #1a0b2e;
        opacity: 0.55;
    }

    /* Glitch triangles — shift & flicker */
    .tri-glitch {
        fill: #c084fc;
        opacity: 0;
    }

    /* Bright accent triangles — fast pop */
    .tri-bright {
        fill: #e879f9;
        opacity: 0;
    }

    /* ── Nav content (above SVG layer) ── */
    .nav-links,
    .logo {
        position: relative;
        z-index: 2;
    }

    .nav-links {
        display: flex;
        flex: 1;
        list-style: none;
        padding: 0;
        margin: 0;
        gap: 30px;
    }
    .nav-links:first-of-type { justify-content: flex-end; }
    .nav-links:last-of-type  { justify-content: flex-start; }

    .nav-links a {
        font-family: 'Pixelify Sans', sans-serif;
        display: inline-block;
        padding: 0.5rem 1.2rem;
        background-color: #683aa8;
        color: #d8b4fe;
        text-decoration: none;
        border-radius: 4px;
        font-weight: 500;
        font-size: 1.5rem;
        letter-spacing: 1px;
        text-transform: uppercase;
        transition: transform 0.2s, background-color 0.2s, box-shadow 0.2s;
        /* subtle link glitch on hover via outline flash */
        position: relative;
    }

    .nav-links a::after {
        content: attr(data-text);
        position: absolute;
        inset: 0;
        padding: inherit;
        color: #e879f9;
        clip-path: inset(0 100% 0 0);
        transition: clip-path 0.3s;
        font-family: inherit;
        font-size: inherit;
        letter-spacing: inherit;
        text-transform: inherit;
        pointer-events: none;
    }

    .nav-links a:hover {
        background-color: #1a0b2e;
        color: #d8b4fe;
        transform: scale(1.1) skew(-5deg);
        box-shadow: 0 0 15px #d8b4fe, 0 0 30px #9d4edd55;
        animation: link-glitch 0.4s steps(1) forwards;
    }

    @keyframes link-glitch {
        0%  { filter: none; }
        20% { filter: hue-rotate(90deg) brightness(1.5); transform: scale(1.1) skew(-5deg) translateX(-2px); }
        40% { filter: none; transform: scale(1.1) skew(-5deg) translateX(2px); }
        60% { filter: hue-rotate(-90deg); transform: scale(1.1) skew(-5deg); }
        80% { filter: none; }
        100%{ filter: none; }
    }

    .logo img {
        height: 100px;
        width: auto;
        filter: drop-shadow(0 0 8px #d8b4fe88);
    }
</style>

<script>
    let lastScrollY = window.scrollY;
    const navbar = document.getElementById('navbar');

    window.addEventListener('scroll', () => {
        if (navbar) {
            navbar.style.transform = window.scrollY > lastScrollY
                ? 'translateY(-100%)'
                : 'translateY(0)';
            lastScrollY = window.scrollY;
        }
    });
</script>